# HarborX Configuration
# Generate a secure 32-byte secret with: openssl rand -hex 32
HARBORX_SECRET=replace_with_a_secure_random_64_char_hex_secret

# Directory on the host where HarborX database, stacks and repositories will be persisted
HARBORX_DATA_DIR=/opt/harborx/data

# Port to expose on the host
PORT=8080

# Set to true if accessing HarborX over HTTPS / reverse proxy (enables Secure flag on session cookies)
COOKIE_SECURE=false
